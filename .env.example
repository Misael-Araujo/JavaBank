# Copy to .env when setting up a local admin account for account credits.
# Leave the admin values blank to run the API without an administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional development overrides. The container generates an ephemeral JWT key when blank.
JWT_SECRET=
JWT_EXPIRATION=PT15M

# Development Compose uses PostgreSQL trust auth only on its private network.
DB_USERNAME=financialservice
DB_PASSWORD=

AUTHORIZATION_URL=https://run.mocky.io/v3/5794d450-d2e2-4412-8131-73d0293ac1cc
NOTIFICATION_URL=https://run.mocky.io/v3/54dc2cf1-3add-45b5-b5a9-6bf7e7f1f4a6
CORS_ALLOWED_ORIGINS=http://localhost:8080
